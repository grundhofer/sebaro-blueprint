{
  "name": "musterapp-webapp",
  "version": "0.1.0",
  "private": true,
  "description": "sebaro starter: a web app without a window. React, TypeScript, Vite.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/budget.ts",
    "preview": "vite preview --port 4173 --strictPort --host 127.0.0.1",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "sebaro:verify": "node src/sebaro/checks/verify-export.mjs src/sebaro --strict",
    "sebaro:product": "python3 src/sebaro/product/product_kit.py check sebaro.product.json --copy src/sebaro --out sebaro-product",
    "sebaro:lint": "sh src/sebaro/checks/lint-web.sh src/app.css dist"
  },
  "dependencies": {
    "i18next": "27.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.1",
    "react-router": "8.5.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "31.0.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.4",
    "vitest": "5.1.0"
  },
  "prettier": {
    "printWidth": 120
  }
}
