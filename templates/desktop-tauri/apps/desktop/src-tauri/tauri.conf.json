{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Musterapp Desktop",
  "identifier": "org.example.musterapp",
  "build": {
    "beforeDevCommand": { "script": "pnpm dev", "cwd": "../ui" },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": { "script": "pnpm build", "cwd": "../ui" },
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'self'; form-action 'self'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
