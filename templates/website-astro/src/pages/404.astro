---
// Not found (TXT-07, AKT-01, AKT-04): what happened and what to do in the first lines, the code only under
// „Technische Angaben“, „Zur Startseite“ as the one primary action. No share image of its own (WEB-09).
// One page for every language, because a static host answers each missing address with the one 404.html: the frame
// and the h1 in the first language, then one part per language with its lang and its code as id (where the language
// link leads) and a link to the start page of that language.
import Base from "../layouts/Base.astro";
import { LANGUAGES } from "../site.mjs";
import { urlOf } from "../lib/languages.mjs";
const [first] = LANGUAGES;
---

<Base lang={first.code} title={first.strings.pages.notFound.title} view="nicht-gefunden" primary>
  {LANGUAGES.map(({ code, strings }, i) => {
    const s = strings.pages.notFound;
    return (
      <section
        class={i === 0 ? "sb-section sb-page-lead" : "sb-section"}
        id={code}
        lang={code}
        aria-labelledby={`nf-${code}`}
      >
        {i === 0 ? (
          <h1 class="sb-page-lead__title" id={`nf-${code}`}>
            {s.title}
          </h1>
        ) : (
          <h2 class="sb-section__title" id={`nf-${code}`}>
            {s.title}
          </h2>
        )}
        <p class={i === 0 ? "sb-page-lead__text" : undefined}>{s.text}</p>
        <details>
          <summary>{s.details}</summary>
          <p>
            {s.status}
            <span class="sb-mono">404</span>
          </p>
        </details>
        <div class="sb-section__actions">
          <a class={i === 0 ? "sb-primary-action" : "sb-secondary-action"} href={urlOf(code, "")} hreflang={code}>
            {s.primary}
          </a>
        </div>
      </section>
    );
  })}
</Base>
