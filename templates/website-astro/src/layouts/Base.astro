---
// Base.astro: the frame of every page (WEB-01 load order, NAV-06/NAV-07 header, WEB-03 footer, WEB-09 share-image
// head, WEB-10 language switch, WEB-02 „Hell oder Dunkel“, FAR-15 „Farbton“, WEB-11 print, ZUG-06 skip link).
// Markup copied from docs/bauteile.html and docs/web.html of the sebaro guide; only sb-* classes of the copy.
import fs from "node:fs";
import path from "node:path";
import { LANGUAGES, PAGES } from "../site.mjs";
import { ogIdOf, urlOf, wordsOf } from "../lib/languages.mjs";
// the site's own CSS is public/css/site.css, linked as a file: an imported stylesheet would arrive as an inline
// <style> in `astro dev`, which the Content-Security-Policy below blocks

interface Props {
  /** the page's language, a code of LANGUAGES (src/site.mjs) */
  lang: string;
  /** <title> without the site suffix */
  title: string;
  /** id of the page in PAGES (src/site.mjs): its address in every language, its header word and its share-image head
   *  from build/og-head/. None for the 404 page: it holds every language itself, in parts with the language's code as
   *  id, so its language link leads to that part and its head names no alternates */
  page?: string;
  /** data-sb-view of the main area (TEC-03) and whether it has a primary action */
  view: string;
  primary?: boolean;
  /** load sb-notes.js and the note popover (BEL-02, BEL-07) */
  notes?: boolean;
}
const { lang, title, page: id, view, primary = false, notes = false } = Astro.props;
const s = wordsOf(lang);
const page = PAGES.find((p) => p.id === id);
if (id !== undefined && !page) throw new Error(`no page "${id}" in PAGES (src/site.mjs)`);
const root = process.cwd();
const read = (p: string) => fs.readFileSync(path.join(root, p), "utf8");
// the build loads the copy's stylesheet and icon sprite cut to what the pages use (scripts/cut.mjs); `astro dev`
// and the first pass of the build, which the cut reads (mode "pages"), load them whole
const cut = import.meta.env.MODE === "production";
// WEB-01: the sprite inline at the top of the body
const sprite = read(cut ? "build/sprite.svg" : "public/sebaro/icons/sprite.svg");
// the product's files from the kit of the copy (sebaro-product/, from sebaro.product.json): the sign tile, inline
// and unchanged (ZEI-07), and the head tags of the favicons and the manifest. Placeholder: the umbrella sign of
// sebaro; a real product declares its own sign (ZEI-03, ZEI-06)
const tile = read("sebaro-product/sign/tile.svg");
const productHead = read("sebaro-product/web/head.snippet.html");
const ogFile = page ? path.join(root, "build", "og-head", `${ogIdOf(page.id, lang)}.head.html`) : null;
const ogHead = ogFile && fs.existsSync(ogFile) ? fs.readFileSync(ogFile, "utf8") : "";
// WEB-10: the same page in every language of the list, for the language link and the alternates in the head
const languages = LANGUAGES.map(({ code }) => ({ code, href: page ? urlOf(code, page.path) : `#${code}` }));
const words = [
  ["apps", "apps/"],
  ["projects", "projekte/"],
  ["about", "ueber/"],
  ["contact", "kontakt/"],
] as const;
const csp =
  "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; " +
  "connect-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="color-scheme" content="light dark" />
    <title>{title}{s.titleSuffix}</title>
    <script is:inline src="/sebaro/js/theme-init.js"></script>
    <link rel="stylesheet" href="/sebaro/fonts/fonts.css" />
    {cut ? <link rel="stylesheet" href="/css/sebaro.cut.css" /> : <link rel="stylesheet" href="/sebaro/tokens.css" />}
    <link rel="stylesheet" href="/sebaro/icons/sprite.css" />
    {!cut && <link rel="stylesheet" href="/sebaro/css/sebaro.css" />}
    <link rel="stylesheet" href="/css/site.css" />
    <Fragment set:html={productHead} />
    {page &&
      languages.map(({ code, href }) => <link rel="alternate" hreflang={code} href={new URL(href, Astro.site).href} />)}
    <Fragment set:html={ogHead} />
  </head>
  <body class="sb-page">
    <Fragment set:html={sprite} />
    <a class="sb-skip-link" href="#inhalt">
      {s.skip}
    </a>
    <header class="sb-site-header">
      <a class="sb-lockup" href={urlOf(lang, "")}>
        <span class="sb-sign-tile sb-sign-tile--32" aria-hidden="true">
          <Fragment set:html={tile} />
        </span>
        <span class="sb-wordmark" translate="no">
          {s.wordmark}
        </span>
      </a>
      <div class="sb-site-header__links">
        <nav class="sb-site-nav" aria-label={s.nav.label}>
          {words.map(([key, href]) => (
            <Fragment>
              <a href={urlOf(lang, href)} aria-current={page?.nav === key ? "page" : undefined}>
                {s.nav[key]}
              </a>{" "}
            </Fragment>
          ))}
        </nav>
        <span class="sb-language-switch" role="group" aria-label={s.language.label}>
          {languages.map(({ code, href }, i) => (
            <Fragment>
              {i > 0 && (
                <Fragment>
                  {" "}
                  <span aria-hidden="true">/</span>{" "}
                </Fragment>
              )}
              <a href={href} lang={code} hreflang={code} aria-current={code === lang ? "true" : undefined}>
                {code.toUpperCase()}
              </a>
            </Fragment>
          ))}
        </span>
      </div>
      <button class="sb-theme-button" type="button">
        {s.theme}
      </button>
    </header>
    <main id="inhalt" class="sb-container" data-sb-view={view} data-sb-primary-expected={primary ? undefined : "0"}>
      <slot />
    </main>
    <footer class="sb-site-footer">
      <p>{s.footer.copyright}</p>
      <ul class="sb-site-footer__links">
        <li>
          <a href={urlOf(lang, "impressum/")}>{s.footer.links.imprint}</a>
        </li>
        <li>
          <a href={urlOf(lang, "datenschutz/")}>{s.footer.links.privacy}</a>
        </li>
        <li>
          <a href={urlOf(lang, "barrierefreiheit/")}>{s.footer.links.accessibility}</a>
        </li>
        {/* „GitHub“ with external-link--16 only when the product has a public repository, always under the AGPL (WEB-03) */}
      </ul>
      <section class="sb-site-footer__display" aria-labelledby="darstellung-h" data-sb-tone-choice hidden>
        <h2 id="darstellung-h">{s.footer.display}</h2>
        <fieldset class="sb-segmented">
          <legend>{s.footer.tone}</legend>
          <div class="sb-segmented__options">
            <label class="sb-segmented__option">
              <input type="radio" name="sb-tone" value="cool" checked />
              <span class="sb-segmented__face">
                <svg class="sb-icon sb-icon--16" aria-hidden="true" focusable="false">
                  <use href="#check--16" />
                </svg>
                {s.footer.cool}
              </span>
            </label>
            <label class="sb-segmented__option">
              <input type="radio" name="sb-tone" value="warm" />
              <span class="sb-segmented__face">
                <svg class="sb-icon sb-icon--16" aria-hidden="true" focusable="false">
                  <use href="#check--16" />
                </svg>
                {s.footer.warm}
              </span>
            </label>
          </div>
        </fieldset>
      </section>
      <p class="sb-visually-hidden" role="status" data-sb-tone-status></p>
    </footer>
    {notes && (
      <div class="sb-note-popover" id="sb-note-popover" popover aria-labelledby="sb-note-popover-claim">
        <p class="sb-note-popover__claim" id="sb-note-popover-claim"></p>
        <div class="sb-note-popover__body"></div>
        <button
          class="sb-secondary-action sb-note-popover__close"
          type="button"
          popovertarget="sb-note-popover"
          popovertargetaction="hide"
        >
          {s.notePopover.close}
        </button>
      </div>
    )}
    <p class="sb-visually-hidden" role="status" data-sb-theme-status></p>
    <script is:inline src="/sebaro/js/theme-button.js"></script>
    <script is:inline src="/sebaro/js/sb-tone.js"></script>
    <script is:inline src="/sebaro/js/sb-print.js"></script>
    <script is:inline src="/sebaro/js/sb-controls.js"></script>
    {notes && <script is:inline src="/sebaro/js/sb-notes.js"></script>}
    <script is:inline src="/sebaro/js/sb-fit.js"></script>
  </body>
</html>
